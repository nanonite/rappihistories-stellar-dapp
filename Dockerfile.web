# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=web-dev-template:latest

FROM ${NODE_IMAGE} AS base
USER root
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV COREPACK_ENABLE_PROJECT_SPEC=0
ARG NPM_CONFIG_REGISTRY=http://verdaccio:4873/
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY}
ENV npm_config_registry=${NPM_CONFIG_REGISTRY}

RUN npm install --global pnpm@9.15.9 --registry "${NPM_CONFIG_REGISTRY}"

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY components/api-indexer/package.json components/api-indexer/package.json
COPY components/kms-gate/package.json components/kms-gate/package.json
COPY components/web/package.json components/web/package.json
COPY components/packages/crypto/package.json components/packages/crypto/package.json
COPY components/packages/domain/package.json components/packages/domain/package.json
COPY components/packages/shared/package.json components/packages/shared/package.json
COPY components/packages/stellar-client/package.json components/packages/stellar-client/package.json
COPY components/packages/storage/package.json components/packages/storage/package.json
COPY components/packages/test-fixtures/package.json components/packages/test-fixtures/package.json
COPY components/packages/wallet/package.json components/packages/wallet/package.json
COPY e2e/package.json e2e/package.json
RUN pnpm install --frozen-lockfile --registry "${NPM_CONFIG_REGISTRY}"

FROM base AS builder
COPY --from=deps /app ./
COPY . .
RUN pnpm build

FROM ${NODE_IMAGE} AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NPM_CONFIG_REGISTRY=http://verdaccio:4873/
ENV npm_config_registry=http://verdaccio:4873/

COPY --from=builder /app/components/web/.next/standalone ./
COPY --from=builder /app/components/web/.next/static ./components/web/.next/static

EXPOSE 3000
CMD ["node", "components/web/server.js"]
