{
  "name": "medichain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "pnpm --filter @medichain/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @medichain/web start",
    "lint": "pnpm --filter @medichain/web lint",
    "typecheck": "pnpm -r typecheck"
  }
}
