{
  "name": "medichain-integration",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "workspaces": [
    "components/web",
    "components/api-indexer",
    "components/kms-gate",
    "components/packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "pnpm --filter @medichain/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @medichain/web start",
    "lint": "pnpm --filter @medichain/web lint",
    "typecheck": "pnpm -r typecheck"
  }
}
